# HTTP
PORT=8080
APP_ORIGIN=http://localhost:3000

# Upstreams
INDEXER_API_URL=http://localhost:42069
ROBINHOOD_RPC_URL=http://127.0.0.1:8545

# Redis (falls back to in-memory if unset — do NOT run prod without this)
REDIS_URL=
RATE_LIMIT=120

# SIWE / sessions
SESSION_SECRET=change-me-to-a-long-random-string
AUTH_DOMAIN=localhost
AUTH_ORIGIN=http://localhost:3000

# IPFS (Pinata)
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud
MEDIA_BASE=

# Chainlink price feeds: {"<assetAddressLower>":"<aggregatorAddress>"}
# zeroAddress key = native ETH feed.
PRICE_FEEDS={}
