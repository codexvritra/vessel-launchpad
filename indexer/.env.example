# Chain / RPC. Robinhood testnet = 46630, mainnet = 4663, local anvil = 31337.
CHAIN_ID=46630
ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Set to the block your factory was deployed at (avoids scanning from genesis).
START_BLOCK=0

# Core contract addresses (from `forge script Deploy`)
FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
GUARD_ADDRESS=
HOOK_ADDRESS=
FEE_SPLITTER_ADDRESS=
COIN_FACTORY_ADDRESS=
MARKET_DEPLOYER_ADDRESS=
BONDING_CURVE_ADDRESS=
TOKEN_LAUNCHER_ADDRESS=

# Comma-separated ERC-20 backing assets to track in/out of TBAs (testnet mocks)
BACKING_ASSETS=

# Postgres (Supabase). Ponder falls back to pglite locally if unset.
DATABASE_URL=
