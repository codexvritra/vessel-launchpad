# Robinhood Chain TESTNET deploy config. Copy to `.env.testnet` and fill in.
# `.env.*` is gitignored — secrets never enter the repo.

NETWORK=testnet

# Robinhood Chain TESTNET (chain id 46630). Public RPC is rate-limited; for a real
# deploy use an Alchemy key: https://robinhood-testnet.g.alchemy.com/v2/<API_KEY>
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Deployer key: import it into Foundry's encrypted keystore ONCE, never paste it
# anywhere. The scripts use --account so the raw key is never in env or the repo:
#   cast wallet import vessel-deployer --interactive
DEPLOYER_ACCOUNT=vessel-deployer

# Address that receives the protocol fee share.
PROTOCOL_RECIPIENT=
PROTOCOL_FEE_BPS=500

# Block explorer verification (Blockscout-style). API key may be blank on Blockscout.
EXPLORER_API_URL=https://explorer.testnet.chain.robinhood.com/api
EXPLORER_API_KEY=

# DEX router (UniswapV2 interface). NOTE: no UniswapV2/Sushi router is deployed on
# Robinhood TESTNET (verified on-chain), so pool-seeding features (coin market,
# direct-to-DEX launch, curve graduation) are MAINNET-only. Leave empty on testnet;
# the NFT launchpad, mint, TBAs, and the bonding curve's virtual liquidity still work.
SUSHI_ROUTER=

# Flagship seed.
MINT_QTY=5
METADATA_BASE=
# Auto-enable a SushiSwap coin market for the flagship at creation (true/false).
ENABLE_COIN_MARKET=false
