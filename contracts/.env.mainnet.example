# Robinhood Chain MAINNET deploy config. Copy to `.env.mainnet` and fill in.
# `.env.*` is gitignored — secrets never enter the repo.
#
# READ THIS: mainnet is not code-gated, it is AUDIT- and LEGAL-gated. The deploy
# script refuses to broadcast to mainnet unless all three acknowledgement flags
# below are set to exactly "yes" — and you must not set them until each is
# genuinely, verifiably true. They are friction on purpose.

NETWORK=mainnet

# Robinhood Chain MAINNET (chain id 4663). Prefer an Alchemy key over the public RPC.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
DEPLOYER_ACCOUNT=vessel-deployer
PROTOCOL_RECIPIENT=
PROTOCOL_FEE_BPS=500
EXPLORER_API_URL=https://robinhoodchain.blockscout.com/api
EXPLORER_API_KEY=

# DEX router (UniswapV2 interface). SushiSwap is NOT on Robinhood Chain — Uniswap
# is the primary AMM. Uniswap V2 Router02 on Robinhood MAINNET (verified on-chain):
#   router  0x89e5db8b5aa49aa85ac63f691524311aeb649eba
#   factory 0x8bceaa40b9acdfaedf85adf4ff01f5ad6517937f
#   WETH    0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
# Our market deployer uses the shared UniswapV2 interface, so it works with this.
SUSHI_ROUTER=0x89e5db8b5aa49aa85ac63f691524311aeb649eba

# Real Chainlink ETH/USD feed on Robinhood mainnet (set for the $3 launch fee).
ETH_USD_FEED=

# --- HARD GATES (all must be "yes" for a mainnet broadcast) ---
# External security audit completed and every finding resolved:
AUDIT_COMPLETE=no
# Written legal opinion from qualified counsel obtained (see ../LEGAL.md):
LEGAL_OPINION=no
# Full testnet end-to-end acceptance checklist passed (see ../DEPLOY.md §6):
TESTNET_VERIFIED=no
# The deployer owner is a multisig/timelock, not an EOA:
OWNER_IS_MULTISIG=no
