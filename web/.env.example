# Vessel web — copy to .env.local for dev, or set these in Vercel's dashboard.
# All are NEXT_PUBLIC_* (inlined into the client bundle) — never put secrets here.

# --- Chain ---
# Robinhood Chain MAINNET = 4663, TESTNET = 46630, local anvil = 31337.
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Optional WebSocket RPC for live push updates (falls back to http polling).
NEXT_PUBLIC_WS_RPC_URL=

# --- Backend URLs (set to your deployed indexer/services, else the board is empty) ---
NEXT_PUBLIC_API_URL=http://localhost:42069
NEXT_PUBLIC_SERVICES_URL=http://localhost:8080

# --- Wallet ---
# Reown/WalletConnect project id (https://cloud.reown.com). Optional:
# without it the app uses the injected/MetaMask connector only.
NEXT_PUBLIC_WC_PROJECT_ID=

# --- Deployed contract addresses (fill in after `forge script Deploy`) ---
NEXT_PUBLIC_FACTORY=
NEXT_PUBLIC_TOKEN_LAUNCHER=
NEXT_PUBLIC_GUARD=
NEXT_PUBLIC_FEE_SPLITTER=
NEXT_PUBLIC_COIN_FACTORY=
NEXT_PUBLIC_MARKET_DEPLOYER=
NEXT_PUBLIC_LIQUIDITY_LAUNCHER=
NEXT_PUBLIC_BONDING_CURVE=

# --- Optional external links ---
NEXT_PUBLIC_DEXSCREENER_URL=https://dexscreener.com/robinhood
NEXT_PUBLIC_SUSHI_SWAP_URL=https://www.sushi.com/swap

# --- Image upload (server-side, NOT exposed to the browser) ---
# A free Pinata JWT (https://app.pinata.cloud -> API Keys) enables the file-upload
# on the launch page. Server-only var — do NOT prefix with NEXT_PUBLIC.
PINATA_JWT=

# Local-only: set to 1 to preview the populated board without a chain/indexer.
NEXT_PUBLIC_SHOW_DEMO=0
